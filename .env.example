DATABASE_URL="postgresql://wanees:wanees_dev@localhost:5432/wanees?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3100"
ADMIN_APP_URL="http://localhost:3200"
# Local demo login for the admin app: on automatically outside production.
# Set "true" only for a loopback-only local production build; never in a deployment.
WANEES_LOCAL_DEMO=""
WANEES_ORGANIZATION_SLUG="wanees-demo"
# Set only in a local/secret environment before seeding if database-backed organizer login is desired.
WANEES_OWNER_PASSWORD=""
# Local-only seeded read-only demo account password (demo@wanees.demo).
WANEES_DEMO_PASSWORD=""
# Optional: show this organizer email and password on the admin login page to everyone
# (for example to hackathon judges). Shown only while they can sign in; leave empty to hide.
WANEES_PUBLIC_DEMO_EMAIL=""
WANEES_PUBLIC_DEMO_PASSWORD=""
# Optional OpenAI Responses API key, server-side only.
OPENAI_API_KEY=""
WANEES_OPENAI_MODEL="gpt-6-luna"
# Live voice call (OpenAI Realtime over WebRTC). The browser only ever receives a 2-minute ephemeral key.
WANEES_OPENAI_REALTIME_MODEL="gpt-realtime-2"
WANEES_OPENAI_REALTIME_VOICE="marin"
WANEES_OPENAI_TRANSCRIBE_MODEL="gpt-4o-mini-transcribe"
# Lock-screen nudges (Web Push). Generate with `npm run push:keys`; empty keys turn the feature off.
WANEES_VAPID_PUBLIC_KEY=""
WANEES_VAPID_PRIVATE_KEY=""
WANEES_VAPID_SUBJECT="mailto:ops@your-domain.example"
# Send due nudges every N seconds from the visitor server itself (single-instance deployments).
WANEES_PUSH_DISPATCH_INTERVAL_SECONDS=""
# Or let an external scheduler call POST /api/v1/internal/push/dispatch with this bearer token (24+ chars).
WANEES_PUSH_DISPATCH_TOKEN=""
# Local testing only: extra push-service hosts (host:port) besides the browser vendors.
WANEES_PUSH_EXTRA_HOSTS=""
# Send Strict-Transport-Security only behind HTTPS in a deployment.
WANEES_HSTS="false"
# Use a deployment-specific secret; never commit the real value.
WANEES_RATE_LIMIT_SALT="change-me"
# Number of reverse proxies in front of the app that append to X-Forwarded-For.
# 0 = ignore forwarded headers (every caller shares one rate-limit address).
# Set to 1 behind a single nginx/load balancer; the app must not be reachable directly.
WANEES_TRUSTED_PROXY_HOPS="0"
# Staged rollout flags. Omit them to use the safe demo defaults.
WANEES_FEATURE_BROWSER_COOKIE_SESSION="true"
WANEES_FEATURE_PROPOSAL_CONCURRENCY="true"
WANEES_FEATURE_MAP_2D_V2="true"
WANEES_FEATURE_LLM_ADAPTER="true"
WANEES_FEATURE_RETENTION_JOB="true"
# Isolated local test/demo clock. Both values are required; never enable in production.
WANEES_ALLOW_CLOCK_OVERRIDE="false"
WANEES_CLOCK_OVERRIDE_MINUTE=""
# Operational history retention (see docs/RETENTION.md). Deletion is opt-in:
# db:retention is a dry run unless WANEES_RETENTION_APPLY is true or --apply is passed.
WANEES_RETENTION_CROWD_SNAPSHOT_DAYS="90"
WANEES_RETENTION_EVENT_UPDATE_DAYS="365"
WANEES_RETENTION_APPLY="false"
# Optional encrypted PostgreSQL backups (keep the encryption key outside GitHub).
WANEES_BACKUP_DIR="/var/backups/wanees"
WANEES_BACKUP_RETENTION_DAYS="7"
WANEES_BACKUP_ENCRYPTION_PASSPHRASE=""
# Optional S3-compatible off-host replication. Set *_REQUIRED=true in production
# so a successful local dump is never reported when off-host replication is absent.
WANEES_BACKUP_OFFSITE_REQUIRED="false"
WANEES_BACKUP_S3_ENDPOINT=""
WANEES_BACKUP_S3_BUCKET=""
WANEES_BACKUP_S3_REGION="us-east-1"
WANEES_BACKUP_S3_ACCESS_KEY_ID=""
WANEES_BACKUP_S3_SECRET_ACCESS_KEY=""
WANEES_BACKUP_S3_PREFIX="wanees"
WANEES_BACKUP_S3_ALLOW_INSECURE="false"
# A maintenance database with CREATEDB permission, on a distinct database from DATABASE_URL.
WANEES_RESTORE_SMOKE_DATABASE_URL=""
# Optional server-side Sentry DSN. No visitor request body, cookie, or user data is sent.
WANEES_ERROR_MONITORING_DSN=""


# Provision the isolated rehearsal on the intended host with npm run db:seed:pitch.
WANEES_PITCH_OPERATOR_PASSWORD=

# Crowd sensing from anonymous visitor devices (see docs/MAP_AND_CROWD_SENSING.md).
# Share of visitors expected to share location through the app (0..1]; scales device counts to people.
WANEES_PRESENCE_SAMPLE_RATE=0.08
# Minimum devices in a zone before a reading is published (privacy floor).
WANEES_PRESENCE_MIN_DEVICES=3
# Zone capacity (people) used when the organizer left Zone.capacity empty.
WANEES_PRESENCE_DEFAULT_CAPACITY=300
